# 运行环境配置示例
# 复制此文件为 .env 并修改实际值

# 网络配置
ROBOT_MOTION_IP=192.168.1.103
PTZ_BASE_URL=http://192.168.1.108
WEBSOCKET_SERVER=ws://192.168.1.200:8765/ws

# 云台认证
